/*
 * Copyright 2026 The Zilkworm Authors
 * SPDX-License-Identifier: MIT OR Apache-2.0
 *
 * Linker script for OpenVM zkVM guest (rv64im bare-metal).
 *
 * Address layout (openvm-platform crate: crates/toolchain/platform/src/memory.rs):
 *   GUEST_MIN_MEM = 0x0000_0400   (below here is reserved)
 *   STACK_TOP     = 0x0020_0400   (sp initialised here; grows downward)
 *   TEXT_START    = 0x0020_0800   (code and data loaded here)
 *   GUEST_MAX_MEM = 0x2000_0000   (top of usable guest address space, 512 MiB)
 *
 * Heap starts at _end (after BSS) and grows upward toward GUEST_MAX_MEM.
 * Stack occupies [GUEST_MIN_MEM, STACK_TOP] (~2 MB).
 */

OUTPUT_FORMAT("elf64-littleriscv", "elf64-littleriscv", "elf64-littleriscv")
OUTPUT_ARCH(riscv)
ENTRY(_start)

PHDRS
{
    phdr_text  PT_LOAD FLAGS(5);         /* R+E – executable code   */
    phdr_ro    PT_LOAD FLAGS(4);         /* R   – read-only data    */
    phdr_rw    PT_LOAD FLAGS(6);         /* R+W – writable data     */
    phdr_stack PT_GNU_STACK FLAGS(6);    /* RW  – stack             */
}

SECTIONS
{
    /* ── Code segment ──────────────────────────────────────────────────── */
    . = 0x00200800;   /* TEXT_START */

    .text : {
        *(.text.unlikely .text.*_unlikely .text.unlikely.*)
        *(.text.exit .text.exit.*)
        *(.text.startup .text.startup.*)
        *(.text.hot .text.hot.*)
        *(SORT(.text.sorted.*))
        *(.text._start)
        *(.text .stub .text.* .gnu.linkonce.t.*)
        *(.gnu.warning)
    } :phdr_text

    .init : { KEEP(*(SORT_NONE(.init))) }
    .fini : { KEEP(*(SORT_NONE(.fini))) }

    PROVIDE(__etext = .);
    PROVIDE(_etext  = .);
    PROVIDE(etext   = .);

    /* ── Read-only data ─────────────────────────────────────────────────── */
    .rodata  : { *(.rodata  .rodata.*  .gnu.linkonce.r.*) } :phdr_ro
    .rodata1 : { *(.rodata1) }

    .eh_frame_hdr : { *(.eh_frame_hdr) *(.eh_frame_entry .eh_frame_entry.*) }
    .eh_frame     : ONLY_IF_RO { KEEP(*(.eh_frame)) *(.eh_frame.*) }

    /* ── Writable data ──────────────────────────────────────────────────── */
    . = DATA_SEGMENT_ALIGN(CONSTANT(MAXPAGESIZE), CONSTANT(COMMONPAGESIZE));

    .preinit_array : {
        PROVIDE_HIDDEN(__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN(__preinit_array_end = .);
    } :phdr_rw

    .init_array : {
        PROVIDE_HIDDEN(__init_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .ctors))
        PROVIDE_HIDDEN(__init_array_end = .);
    }

    .fini_array : {
        PROVIDE_HIDDEN(__fini_array_start = .);
        KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
        KEEP(*(.fini_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .dtors))
        PROVIDE_HIDDEN(__fini_array_end = .);
    }

    .ctors : {
        KEEP(*crtbegin.o(.ctors))
        KEEP(*crtbegin?.o(.ctors))
        KEEP(*(EXCLUDE_FILE(*crtend.o *crtend?.o) .ctors))
        KEEP(*(SORT(.ctors.*)))
        KEEP(*(.ctors))
    }

    .dtors : {
        KEEP(*crtbegin.o(.dtors))
        KEEP(*crtbegin?.o(.dtors))
        KEEP(*(EXCLUDE_FILE(*crtend.o *crtend?.o) .dtors))
        KEEP(*(SORT(.dtors.*)))
        KEEP(*(.dtors))
    }

    .data : {
        __DATA_BEGIN__ = .;
        *(.data .data.* .gnu.linkonce.d.*)
        SORT(CONSTRUCTORS)
    }

    .data1 : { *(.data1) }

    .got : { *(.got.plt) *(.igot.plt) *(.got) *(.igot) }

    .sdata : {
        __SDATA_BEGIN__ = .;
        *(.srodata.cst16) *(.srodata.cst8) *(.srodata.cst4) *(.srodata.cst2)
        *(.srodata .srodata.*)
        *(.sdata .sdata.* .gnu.linkonce.s.*)
    }

    _edata = .; PROVIDE(edata = .);
    . = .;
    __bss_start = .;

    .sbss : {
        *(.dynsbss)
        *(.sbss .sbss.* .gnu.linkonce.sb.*)
        *(.scommon)
    }

    .bss : {
        *(.dynbss)
        *(.bss .bss.* .gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(. != 0 ? 8 : 1);
    }

    . = ALIGN(8);
    __BSS_END__ = .;

    /* GP-relative addressing window (must follow __SDATA_BEGIN__ and __DATA_BEGIN__) */
    __global_pointer$ = MIN(__SDATA_BEGIN__ + 0x800,
                            MAX(__DATA_BEGIN__ + 0x800, __BSS_END__ - 0x800));

    _end = .; PROVIDE(end = .);

    /* Heap (zkvm-standards static-library-and-linker-script): end of BSS up
       to GUEST_MAX_MEM. */
    _heap_start = ALIGN(8);
    _heap_end   = 0x20000000;
    . = DATA_SEGMENT_END(.);

    /* ── Debug sections (discarded in release) ──────────────────────────── */
    .stab          0 : { *(.stab) }
    .stabstr       0 : { *(.stabstr) }
    .debug         0 : { *(.debug) }
    .debug_info    0 : { *(.debug_info .gnu.linkonce.wi.*) }
    .debug_abbrev  0 : { *(.debug_abbrev) }
    .debug_line    0 : { *(.debug_line .debug_line.* .debug_line_end) }
    .debug_frame   0 : { *(.debug_frame) }
    .debug_str     0 : { *(.debug_str) }
    .debug_loc     0 : { *(.debug_loc) }
    .debug_ranges  0 : { *(.debug_ranges) }
    .debug_macro   0 : { *(.debug_macro) }
    .debug_names   0 : { *(.debug_names) }

    /DISCARD/ : { *(.note.GNU-stack) *(.gnu_debuglink) *(.gnu.lto_*) }
}
