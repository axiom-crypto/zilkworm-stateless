+    if (bit_width == 0) [[unlikely]]
+        return;
+
+    if (openvm_bn_is_zero(p)) [[unlikely]]
+        return;
+
+    std::copy_n(p, OPENVM_BN_POINT_LIMBS, r);  // r = p
+    for (auto i = bit_width - 1; i != 0; --i)
+    {
+        if (!openvm_bn_is_zero(r)) [[likely]]
+            openvm::bn254_ec_double(r, r);
+        if ((c & (uint256{1} << (i - 1))) != 0)
+            openvm_bn_add(r, p);
+    }
+}
