+            return;
+        }
+        if (ry == evmmax::bn254::Curve::FIELD_PRIME - py)
+        {
+            std::fill_n(r, OPENVM_BN_POINT_LIMBS, 0);
+            return;
+        }
+    }
+
+    openvm::bn254_ec_add_ne(r, r, p);
+}
+
+// r = [c]p via MSB-first double-and-add (mirrors sp1_bn_mul).
+void openvm_bn_mul(openvm_bn_AffinePoint r, const openvm_bn_AffinePoint p, uint256 c) noexcept
+{
