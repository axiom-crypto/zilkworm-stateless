+[[gnu::always_inline]] inline bool openvm_bn_is_zero(const openvm_bn_AffinePoint p) noexcept
+{
+    uint64_t fold = 0;
+    for (size_t i = 0; i < OPENVM_BN_POINT_LIMBS; ++i)
+        fold |= p[i];
+    return fold == 0;
+}
+
+inline void openvm_bn_point_from_bytes(openvm_bn_AffinePoint r, const uint8_t bytes[64]) noexcept
+{
+    for (size_t i = 0; i < 4; ++i)
+        r[i] = intx::be::unsafe::load<uint64_t>(&bytes[24 - i * 8]);
+    for (size_t i = 0; i < 4; ++i)
+        r[i + 4] = intx::be::unsafe::load<uint64_t>(&bytes[56 - i * 8]);
+}
+
+inline void openvm_bn_point_to_bytes(uint8_t bytes[64], const openvm_bn_AffinePoint r) noexcept
+{
+    for (size_t i = 0; i < 4; ++i)
+        intx::be::unsafe::store<uint64_t>(&bytes[24 - i * 8], r[i]);
+    for (size_t i = 0; i < 4; ++i)
+        intx::be::unsafe::store<uint64_t>(&bytes[56 - i * 8], r[i + 4]);
+}
+
+// r += p with the identity / equal-x branching the raw EC_ADD_NE
+// instruction requires (mirrors sp1_bn_add).
+void openvm_bn_add(openvm_bn_AffinePoint r, const openvm_bn_AffinePoint p) noexcept
+{
+    if (openvm_bn_is_zero(p)) [[unlikely]]
+        return;
+    if (openvm_bn_is_zero(r)) [[unlikely]]
+    {
+        std::copy_n(p, OPENVM_BN_POINT_LIMBS, r);
+        return;
+    }
+
+    const auto& rx = *(const uint256*)&r[0];
+    const auto& ry = *(const uint256*)&r[OPENVM_BN_POINT_LIMBS / 2];
+    const auto& px = *(const uint256*)&p[0];
+    const auto& py = *(const uint256*)&p[OPENVM_BN_POINT_LIMBS / 2];
+
+    if (rx == px) [[unlikely]]
+    {
+        if (ry == py)
